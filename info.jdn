{:name "persimmon"
 :version "DEVEL"
 :description "Persistent immutable data structures"
 :author "Michael Camilleri"
 :license "MIT"
 :url "https://github.com/pyrmont/persimmon"
 :repo "git+https://github.com/pyrmont/persimmon"
 :dependencies []
 :vendored [{:name "testament"
             :url "https://github.com/pyrmont/testament"
             :prefix "deps/testament"
             :paths ["lib/testament.janet"
                     "init.janet"
                     "LICENSE"]}]
 :artifacts {:executables []
             :libraries []
             :manpages []
             :natives [{:name "persimmon"
                        # Files directly under src are the host-agnostic core.
                        # Host bindings live below src/bind; only the Janet
                        # binding includes janet.h.
                        :files ["src/persimmon.c"
                                "src/persimmon_vector.c"
                                "src/persimmon_list.c"
                                "src/persimmon_hamt.c"
                                "src/persimmon_map.c"
                                "src/persimmon_set.c"
                                "src/bind/janet/wrapper.c"]
                        # The core reaches for C11 atomics when the
                        # toolchain has them and falls back to compiler
                        # builtins otherwise, so c99 remains enough.
                        :cflags {:posix ["-std=c99"
                                         "-Wall"
                                         "-Wextra"
                                         "-O3"]}}]
             :scripts []}}
